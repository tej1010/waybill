# Copy to .env on your production server (never commit real .env)

NODE_ENV=production
LOG_LEVEL=info
PORT=5001

# Public URLs (no trailing slash)
# WhatsApp-only on AWS: set FRONTEND_URL to your API URL (CORS not used by bot)
FRONTEND_URL=https://api.yourdomain.com
# Optional extra origins (comma-separated) for CORS
# CORS_ORIGINS=

# Only if you build/host the React app (not needed for WhatsApp bot):
# VITE_API_URL=https://api.yourdomain.com

# Sandbox / Quicko — use LIVE keys for production e-Way Bill
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
SANDBOX_API_VERSION=1.0.0
SANDBOX_API_SOURCE=primary
SANDBOX_BASE_URL=https://api.sandbox.co.in

# Meta WhatsApp — use permanent System User token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
PUBLIC_WEBHOOK_URL=https://api.yourdomain.com

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=eway_prod
PHONE_REGISTRY_SECRET=
MAX_PHONES_PER_ACCOUNT=10
