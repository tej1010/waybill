NODE_ENV=development
LOG_LEVEL=debug
PORT=5001
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5001
# Optional: comma-separated extra CORS origins
# CORS_ORIGINS=

SANDBOX_API_KEY=key_test_xxx
SANDBOX_API_SECRET=secret_test_xxx
SANDBOX_API_VERSION=1.0.0
SANDBOX_API_SOURCE=primary
# SANDBOX_ACCESS_TOKEN=
# All Sandbox API calls use this base URL (test + live)
SANDBOX_BASE_URL=https://api.sandbox.co.in

# Meta WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
# Or use WHATSAPP_TOKEN (alias)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=ewaybill_verify_token
WHATSAPP_API_VERSION=v25.0
# Your public HTTPS URL (ngrok / cloudflare) — no trailing slash
PUBLIC_WEBHOOK_URL=https://your-subdomain.ngrok-free.dev
WHATSAPP_TEST_PHONE=919876543210
# Optional — auto-detected from token if omitted
# WHATSAPP_APP_ID=
# WHATSAPP_WABA_ID=

# MongoDB — WhatsApp user records (phone, User ID, GSTIN; password encrypted)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=eway

# Encrypts E-Way Bill passwords at rest (min 16 characters)
PHONE_REGISTRY_SECRET=change-me-to-a-long-random-secret
# One-time import from old JSON file if collection is empty
# PHONE_REGISTRY_PATH=backend/data/phone-registry.json
# Max WhatsApp numbers per User ID + GSTIN (default 10)
MAX_PHONES_PER_ACCOUNT=10
# Seed backend/src/config/onboardedUsers.js to MongoDB on startup (set false to disable)
SEED_ONBOARDED_USERS=true
